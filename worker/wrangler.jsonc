{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // 読み取りを許す Origin。パスは含めない
    "ALLOWED_ORIGINS": [
      // GitHub Pages
      "https://nagiurrrr.github.io",
      // npm run dev の開発用サーバー
      "http://localhost:5173",
    ],
  },
  // ランキングと記事を 1 日置いておく場所
  "kv_namespaces": [
    { "binding": "CACHE", "id": "5aca9470a58145cd861cf0b08e61429e" },
  ],
  // 同じ IP から 1 分に呼べる回数。namespace_id はアカウントの中で制限を見分ける番号で、秘密ではない
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
